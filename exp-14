
print("DIET RECOMMENDATION SYSTEM")

age = int(input("Enter your age: "))
weight = float(input("Enter your weight in kg: "))
activity = input("Enter activity level (low/medium/high): ").lower()

print("\nDiet Recommendation:")

if age < 18:
    print("Eat a balanced diet with fruits, vegetables and protein.")

elif activity == "low":
    print("Include vegetables, fruits and whole grains.")
